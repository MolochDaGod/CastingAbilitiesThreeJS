      "target-of-target",
      "cast-bar",
      "weapon-skills",
      "hud-settings",
      "move-anything",
      "advanced-hotkeys"
    ],
    "usageStates": [
      "explore",
      "combat",
      "inventory",
      "crafting",
      "dialogue",
      "dead",
      "menu"
    ],
    "dataBindings": {
      "character": {
        "path": "/api/characters/:id",
        "fills": [
          "pf1",
          "attr1"
        ]
      },
      "inventory": {
        "path": "/api/characters/:id/inventory",
        "fills": [
          "inv1"
        ]
      },
      "equipment": {
        "path": "/api/characters/:id/equipment",
        "fills": [
          "eq1"
        ]
      },
      "crafting": {
        "path": "https://objectstore.grudge-studio.com/api/v1/recipes.json",
        "fills": [
          "shop1"
        ]
      }
    },
    "inputProfile": "warlords-combat",
    "tags": [
      "flagship",
      "mmo",
      "wcs"
    ]
  },
