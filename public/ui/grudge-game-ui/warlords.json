    "description": "Full Warlords play HUD: player/target/boss frames (bars-hud 002/004), target-of-target, cast bar, hotbar weapon skills, bag, paperdoll, craft. HUD Settings: move anything, skins, size, advanced hotkeys.",
    "mainPanelUrl": "https://ui.grudge-studio.com/main-panel.html?era=warlords",
    "mainPanelEmbed": "https://ui.grudge-studio.com/main-panel.html?era=warlords&embed=1",
    "equipmentLayout": "paperdoll-tactical",
    "barsHud": {
      "bossPrimary": "boss-frames/boss_frame_002.png",
      "bossAlternate": "boss-frames/boss_frame_004.png",
      "base": "/assets/bars-hud/"
    },
    "hudSettings": {
      "moveAnything": true,
      "modules": ["bars-hud-ssot.js", "hud-settings.js", "game-ui-runtime.js"]
    },
    "features": [
      "inventory",
      "equipment",
      "paperdoll",
      "main-panel",
      "crafting",
      "quests",
      "combat",
      "chat",
